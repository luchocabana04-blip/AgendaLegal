<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Mariana Sánchez &amp; Asociados — Agenda</title>
  <link rel="manifest" href="./manifest.json">
  <meta name="theme-color" content="#C9A84C">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Agenda Legal">
  <link rel="apple-touch-icon" href="./apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght=0,500;0,700;1,500&family=Jost:wght=300;400;500;600&display=swap" rel="stylesheet">
  
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#07090F;--s1:#0D1120;--s2:#141C33;--s3:#1A2240;--s4:#22304C;
      --bd:#2A3860;--bd2:#1A2440;
      --gold:#C9A84C;--gold2:#E8C870;--gold3:#9B7A30;
      --tx:#DDD8CC;--tx2:#8A9AB8;--tx3:#35486A;
      --green:#3DAA6A;--red:#C94C4C;
      --safe-t:env(safe-area-inset-top,0px);
      --safe-b:env(safe-area-inset-bottom,0px);
    }
    html,body,#root{height:100%}
    body{font-family:'Jost',sans-serif;background:var(--bg);color:var(--tx);overflow:hidden;
      padding-top:var(--safe-t);padding-bottom:var(--safe-b);-webkit-font-smoothing:antialiased}
    *{-webkit-tap-highlight-color:transparent}
    button,a{touch-action:manipulation}
    input,select,textarea{background:var(--s3);border:1px solid var(--bd2);color:var(--tx);
      font-family:'Jost',sans-serif;border-radius:7px;padding:9px 13px;width:100%;font-size:13.5px;outline:none}
    input:focus,select:focus,textarea:focus{border-color:var(--gold)}
    button{cursor:pointer;font-family:'Jost',sans-serif;border:none}

    @keyframes loginFade {from{opacity:0;transform:scale(.97) translateY(14px)}to{opacity:1;transform:scale(1) translateY(0)}}
    @keyframes spin      {to{transform:rotate(360deg)}}
    @keyframes fadeIn    {from{opacity:0}to{opacity:1}}

    /* PANTALLA CENTRAL */
    .pant-bg{height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);position:relative}
    .card{background:var(--s1);border:1px solid var(--bd2);border-radius:18px;
      padding:42px 40px;width:min(460px,calc(100vw - 36px));position:relative;z-index:1;
      box-shadow:0 50px 100px rgba(0,0,0,.72);animation:loginFade .4s cubic-bezier(.22,.68,0,1.2)}
    .sello{width:68px;height:68px;border:1.5px solid var(--gold);border-radius:50%;
      margin:0 auto 20px;display:flex;align-items:center;justify-content:center;
      font-family:'Playfair Display',serif;font-size:11px;color:var(--gold);text-align:center;line-height:1.3}
    .firma{font-family:'Playfair Display',serif;font-size:21px;font-weight:700;text-align:center;color:var(--tx);line-height:1.3}
    .firma-sub{font-size:10px;color:var(--gold);text-align:center;letter-spacing:.22em;text-transform:uppercase;margin-top:5px;margin-bottom:28px}
    .divider{border:none;border-top:1px solid var(--bd2);margin:0 0 20px}
    .cita{font-family:'Georgia',serif;font-style:italic;font-size:13px;color:var(--tx2);text-align:center;line-height:1.75;margin-bottom:26px}
    
    /* BOTONES */
    .btn-gold{width:100%;padding:15px;background:linear-gradient(145deg,var(--gold3),var(--gold));
      border-radius:9px;color:#08060A;font-size:12.5px;font-weight:700;
      letter-spacing:.18em;text-transform:uppercase;transition:all .3s;
      box-shadow:0 5px 26px rgba(201,168,76,.2);display:inline-flex;align-items:center;justify-content:center;gap:8px}
    .btn-gold:hover:not(:disabled){transform:translateY(-1px);background:linear-gradient(145deg,var(--gold),var(--gold2))}
    .card-footer{text-align:center;margin-top:20px;font-size:10px;color:var(--tx3)}

    /* MODALES & INTERFAZ */
    .btn-p{padding:10px 18px;background:linear-gradient(135deg,var(--gold3),var(--gold));color:#000;font-weight:600;font-size:12px;border-radius:6px}
    .btn-d{padding:10px 14px;background:rgba(201,76,76,0.15);color:#FF8888;border:1px solid rgba(201,76,76,0.3);font-size:12px;border-radius:6px;margin-right:auto}
    .btn-s{padding:10px 14px;background:var(--s3);color:var(--tx2);border:1px solid var(--bd2);font-size:12px;border-radius:6px}
    
    .cfg-hdg{font-size:16px;font-family:'Playfair Display',serif;color:var(--tx);text-align:center;margin-bottom:4px}
    .cfg-sub{font-size:12px;color:var(--tx2);text-align:center;margin-bottom:18px}
    .f-grp{display:flex;flex-direction:column;margin-bottom:12px}
    .f-lbl{font-size:10px;color:var(--tx2);text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
    .msg-err{background:rgba(201,76,76,.11);border:1px solid rgba(201,76,76,.33);border-radius:7px;padding:10px 14px;font-size:12px;color:#E07070;margin-bottom:12px}

    /* LAYOUT CORE */
    .layout{display:grid;grid-template-columns:260px 1fr;height:100vh;overflow:hidden}
    .sidebar{background:var(--s1);border-right:1px solid var(--bd2);display:flex;flex-direction:column;overflow:hidden}
    .sb-hd{padding:18px 14px 15px;border-bottom:1px solid var(--bd2)}
    .sb-logo{display:flex;align-items:center;gap:9px}
    .l-sello{width:36px;height:36px;border:1.5px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:8px;color:var(--gold);text-align:center}
    .l-nm{font-family:'Playfair Display',serif;font-size:12px;font-weight:700;color:var(--tx);line-height:1.3}
    .l-sb{font-size:9px;color:var(--gold);letter-spacing:.16em;text-transform:uppercase}
    .sb-body{flex:1;overflow-y:auto;padding:10px}
    .sb-sec{font-size:9px;color:var(--tx3);text-transform:uppercase;letter-spacing:.14em;padding:8px 6px 5px}
    
    .stat-row{display:flex;align-items:center;justify-content:space-between;padding:8px 11px;background:var(--s2);border-radius:7px;margin-bottom:4px}
    .stat-lbl{font-size:11px;color:var(--tx2)}
    .stat-val{font-family:'Playfair Display',serif;font-size:20px;color:var(--tx)}

    .abg-row{display:flex;align-items:center;gap:9px;padding:6px 7px;border-radius:7px;cursor:pointer}
    .abg-row:hover, .abg-row.on{background:var(--s2)}
    .av{width:29px;height:29px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#000}
    .a-nm{font-size:12px;color:var(--tx);font-weight:500}
    .a-rl{font-size:10px;color:var(--tx2)}

    .sb-ft{padding:10px 12px;border-top:1px solid var(--bd2);display:flex;flex-direction:column;gap:6px}
    .cfg-btn{width:100%;padding:8px;background:var(--s2);border:1px solid var(--bd2);border-radius:6px;color:var(--tx2);font-size:11px}
    .logout-btn{background:rgba(201,76,76,0.1);color:#E07070}

    /* MAIN PANEL */
    .main{display:flex;flex-direction:column;overflow:hidden;background:var(--bg)}
    .main-hd{background:var(--s1);border-bottom:1px solid var(--bd2);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px}
    .nav-btn{width:30px;height:30px;border:1px solid var(--bd2);background:transparent;color:var(--tx2);border-radius:6px}
    .mes-tit{font-family:'Playfair Display',serif;font-size:18px;color:var(--tx)}
    .anio-lb{font-size:13px;color:var(--tx2);margin-left:5px}
    .vtabs{display:flex;gap:2px;background:var(--s2);padding:3px;border-radius:8px}
    .vtab{padding:5px 12px;background:transparent;color:var(--tx2);font-size:11px;border-radius:6px}
    .vtab.on{background:var(--s4);color:var(--gold)}
    
    .add-btn{padding:8px 14px;background:linear-gradient(135deg,var(--gold3),var(--gold));border-radius:7px;color:#08060A;font-size:12px;font-weight:700}
    .pdf-btn{background:var(--s2);border:1px solid var(--bd);color:var(--tx);padding:8px 12px;font-size:12px;border-radius:7px}

    .cal-scroll{flex:1;overflow-y:auto;padding:12px}

    /* MATRIZ MENSUAL */
    .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--bd2);border:1px solid var(--bd2);border-radius:10px;overflow:hidden}
    .cal-hdr{background:var(--s1);text-align:center;padding:8px 4px;font-size:10px;color:var(--tx2);text-transform:uppercase}
    .cal-cell{background:var(--s1);min-height:102px;padding:6px;cursor:pointer;display:flex;flex-direction:column}
    .cal-cell.otra{background:var(--bg);opacity:0.3}
    .cal-cell.hoy{background:var(--s2);border-top:2px solid var(--gold)}
    .dn{font-size:12.5px;font-weight:500;color:var(--tx2);width:24px;height:24px;display:flex;align-items:center;justify-content:center}
    .cal-cell.hoy .dn{background:var(--gold);color:#000;border-radius:50%;font-weight:700}
    
    .chip{padding:2px 5px;border-radius:4px;font-size:10px;color:#fff;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    /* VISTAS EXTRAS */
    .wk-wrap{overflow-y:auto;max-height:calc(100vh - 120px)}
    .wk-hdr{display:grid;grid-template-columns:50px repeat(7,1fr);position:sticky;top:0;background:var(--s1);z-index:5;border-bottom:1px solid var(--bd2)}
    .wk-dhdr{padding:8px 4px;text-align:center;font-size:11px;color:var(--tx2)}
    .wk-body{display:grid;grid-template-columns:50px repeat(7,1fr)}
    .wk-tlbl{height:54px;display:flex;align-items:flex-start;justify-content:flex-end;padding-right:6px;font-size:9px;color:var(--tx3)}
    .wk-dcol{border-left:1px solid var(--bd2)}
    .wk-hcel{height:54px;border-bottom:1px solid var(--bd2);cursor:pointer}

    .dia-hdr{padding:12px 14px;border-bottom:1px solid var(--bd2);font-family:'Playfair Display',serif;font-size:15px}
    .vacio{font-size:12px;color:var(--tx3);text-align:center;padding:24px;font-style:italic}

    .list-card{background:var(--s1);border:1px solid var(--bd2);border-radius:9px;padding:11px 13px;cursor:pointer;display:flex;gap:11px;margin-bottom:8px}
    .list-bar{width:4px;border-radius:2px;align-self:stretch}
    .list-tit{font-size:13px;font-weight:500;color:var(--tx)}
    .list-meta{font-size:11px;color:var(--tx2)}

    /* MODAL INTERNO */
    .modal-ov{position:fixed;inset:0;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;z-index:100;backdrop-filter:blur(4px);padding:12px}
    .modal-box{background:var(--s1);border:1px solid var(--bd);border-radius:14px;width:min(540px,100%);max-height:90vh;overflow-y:auto}
    .modal-hd{padding:16px 20px;border-bottom:1px solid var(--bd2);display:flex;align-items:center;justify-content:space-between}
    .modal-tit{font-family:'Playfair Display',serif;font-size:17px}
    .modal-bd{padding:18px 20px;display:flex;flex-direction:column;gap:14px}
    .modal-ft{padding:12px 20px;border-top:1px solid var(--bd2);display:flex;gap:8px;justify-content:flex-end}
    .f-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}

    /* INNER CORE SPINNER */
    .local-spin{width:32px;height:32px;border:3px solid var(--bd);border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite;margin:40px auto}
  </style>
</head>
<body>

<div id="root">
  <div style="height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#07090F; gap:12px;">
    <div style="font-family:'Playfair Display',serif; font-size:20px; color:#C9A84C;">Mariana Sánchez &amp; Asociados</div>
    <div style="width:24px; height:24px; border:2px solid #1A2440; border-top-color:#C9A84C; border-radius:50%; animation:spin 1s linear infinite;"></div>
  </div>
</div>
<div id="pdf-render-area" style="display:none;"></div>

<script type="text/babel">
const { useState, useEffect } = React;
const { createClient } = window.supabase;

const ABOGADOS = [
  { id:"p",  nombre:"Dra. Mariana Sánchez", rol:"Socia Principal",   color:"#C9A84C", ini:"MS" },
  { id:"a1", nombre:"Dr. Carlos Mendoza",   rol:"Abogado Asociado",  color:"#5491C8", ini:"CM" },
  { id:"a2", nombre:"Dra. Ana Rivas",       rol:"Abogada Asociada",  color:"#4DAAA0", ini:"AR" },
  { id:"a3", nombre:"Dr. Pablo Torres",     rol:"Abogado Asociado",  color:"#8E6DC4", ini:"PT" },
  { id:"a4", nombre:"Dra. Laura Vega",      rol:"Abogada Asociada",  color:"#C46D6D", ini:"LV" },
];

const DIAS = ["Dom","Lun","Mar","Mié","Jue","Vie","Sáb"];
const MESES = ["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
const hoyStr = () => new Date().toISOString().split("T")[0];

/* CONFIGURACIÓN SEGURA */
function PantallaConfig({ onConectado }) {
  const [url, setUrl] = useState(localStorage.getItem("sb_url")||"");
  const [key, setKey] = useState(localStorage.getItem("sb_key")||"");
  const [busy, setBusy] = useState(false);
  const [err, setErr] = useState("");

  const conectar = async () => {
    setErr("");
    if (!url.trim() || !key.trim()) { setErr("Complete ambos campos corporativos."); return; }
    setBusy(true);
    try {
      const sbClient = createClient(url.trim(), key.trim());
      const { error } = await sbClient.from("eventos").select("id").limit(1);
      if (error && error.code !== "PGRST116") throw error;
      
      localStorage.setItem("sb_url", url.trim());
      localStorage.setItem("sb_key", key.trim());
      onConectado(sbClient);
    } catch(e) {
      setErr("Fallo crítico de enlace. Verifique los parámetros ingresados.");
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="pant-bg">
      <div className="card">
        <div className="sello">M.S.<br/>&amp;A.</div>
        <div className="firma">MARIANA SÁNCHEZ<br/>&amp; ASOCIADOS</div>
        <div className="firma-sub">Estudio Jurídico</div>
        <hr className="divider"/>
        <div className="cfg-hdg">Infraestructura Supabase</div>
        <div className="cfg-sub">Vincule el clúster seguro para sincronizar expedientes.</div>
        {err && <div className="msg-err">{err}</div>}
        <div className="f-grp">
          <label className="f-lbl">URL de Supabase</label>
          <input value={url} onChange={e=>setUrl(e.target.value)} placeholder="https://your-id.supabase.co" disabled={busy}/>
        </div>
        <div className="f-grp" style={{marginBottom:22}}>
          <label className="f-lbl">Anon Public Key</label>
          <input type="password" value={key} onChange={e=>setKey(e.target.value)} placeholder="eyJhbGciOiJIUzI1NiIsIn..." disabled={busy}/>
        </div>
        <button className="btn-gold" onClick={conectar} disabled={busy}>
          {busy ? "VERIFICANDO..." : "ESTABLECER CONEXIÓN"}
        </button>
      </div>
    </div>
  );
}

/* LOGIN */
function Ingreso({ alEntrar, alConfigurar }) {
  return (
    <div className="pant-bg">
      <div className="card">
        <div className="sello">M.S.<br/>&amp;A.</div>
        <div className="firma">MARIANA SÁNCHEZ<br/>&amp; ASOCIADOS</div>
        <div className="firma-sub">Estudio Jurídico</div>
        <hr className="divider"/>
        <p className="cita">"La justicia y la diligencia procesal sostienen la solidez del bufete corporativo."</p>
        <button className="btn-gold" onClick={alEntrar} style={{marginBottom: 14}}>INGRESAR A LA AGENDA</button>
        <button className="cfg-btn" onClick={alConfigurar}>⚙️ Configurar Servidor Externo</button>
        <div className="card-footer">Estudio Jurídico Multiusuario Premium</div>
      </div>
    </div>
  );
}

/* SIDEBAR */
function Barra({ eventos, filtro, setFiltro, onCerrarSesion }) {
  const cH = eventos.filter(e=>e.date===hoyStr()).length;
  const cA = eventos.filter(e=>e.type==="audiencia").length;

  return (
    <div className="sidebar">
      <div className="sb-hd">
        <div className="sb-logo">
          <div className="l-sello">M.S.<br/>&amp;A.</div>
          <div>
            <div className="l-nm">Mariana Sánchez<br/>&amp; Asociados</div>
            <div className="l-sb">Estudio Jurídico</div>
          </div>
        </div>
      </div>
      <div className="sb-body">
        <div className="sb-sec">Métricas Clave</div>
        <div className="stat-row"><span className="stat-lbl">Eventos de Hoy</span><span className="stat-val">{cH}</span></div>
        <div className="stat-row"><span className="stat-lbl">Audiencias</span><span className="stat-val">{cA}</span></div>
        
        <div className="sb-sec" style={{marginTop:20}}>Filtro de Profesionales</div>
        <div className={`abg-row ${filtro===null?"on":""}`} onClick={()=>setFiltro(null)}>
          <div className="av" style={{background:"var(--s4)",color:"var(--tx)"}}>∀</div>
          <div style={{marginLeft:8}}><div className="a-nm">Todo el Bufete</div><div className="a-rl">{eventos.length} registros</div></div>
        </div>
        {ABOGADOS.map(a=>(
          <div key={a.id} className={`abg-row ${filtro===a.id?"on":""}`} onClick={()=>setFiltro(a.id)}>
            <div className="av" style={{background:a.color}}>{a.ini}</div>
            <div style={{marginLeft:8}}><div className="a-nm">{a.nombre}</div><div className="a-rl">{eventos.filter(e=>e.lawyers?.includes(a.id)).length} ítems</div></div>
          </div>
        ))}
      </div>
      <div className="sb-ft">
        <button className="cfg-btn logout-btn" onClick={onCerrarSesion}>🚪 Desconectar</button>
      </div>
    </div>
  );
}

/* COMPONENTES DE VISTA */
function VistaMes({año,mes,eventos,alDia,alEv}) {
  const pri = new Date(año,mes,1).getDay();
  const dias = new Date(año,mes+1,0).getDate();
  const prev = new Date(año,mes,0).getDate();
  const celdas = [];

  for(let i=pri-1;i>=0;i--) celdas.push({d:prev-i,otra:true,m:mes-1});
  for(let i=1;i<=dias;i++) celdas.push({d:i,otra:false,m:mes});
  const tot = Math.ceil(celdas.length/7)*7;
  let len = celdas.length;
  for(let i=1;i<=tot-len;i++) celdas.push({d:i,otra:true,m:mes+1});

  return (
    <div className="cal-grid">
      {DIAS.map(d=><div key={d} className="cal-hdr">{d}</div>)}
      {celdas.map((c,idx)=>{
        const ds = `${año}-${String(c.m+1).padStart(2,"0")}-${String(c.d).padStart(2,"0")}`;
        const des = eventos.filter(e=>e.date===ds);
        return (
          <div key={idx} className={`cal-cell ${c.otra?"otra":""} ${ds===hoyStr()?"hoy":""}`} onClick={()=>!c.otra && alDia(ds)}>
            <div className="dn">{c.d}</div>
            <div style={{flex:1,overflow:"hidden"}}>
              {des.slice(0,3).map(e=>(
                <div key={e.id} className="chip" style={{background:ABOGADOS.find(a=>a.id===(e.lawyers?.[0]||"p"))?.color}} onClick={(x)=>{x.stopPropagation(); alEv(e);}}>
                  {e.title}
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  );
}

function VistaSemana({fecha,eventos,alEv,alSlot}) {
  const inicio = new Date(fecha); inicio.setDate(inicio.getDate() - inicio.getDay());
  const diasArr = Array.from({length:7},(_,i)=>{ const d = new Date(inicio); d.setDate(d.getDate()+i); return d; });
  const hs = Array.from({length:11},(_,i)=>i+8); // 8:00 a 18:00

  return (
    <div className="wk-wrap">
      <div className="wk-hdr">
        <div className="wk-dhdr">Hora</div>
        {diasArr.map((d,i)=><div key={i} className="wk-dhdr"><b>{DIAS[d.getDay()]}</b><br/>{d.getDate()}</div>)}
      </div>
      <div className="wk-body">
        <div>{hs.map(h=><div key={h} className="wk-tlbl">{h}:00
